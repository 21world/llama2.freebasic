            let imageUrl = "https://io.narrative.io/?companyId=2440&id=first_party%3A1513fcdd-a646-421a-bc22-47974ded0cad&id=site_name%3Asourceforge.net&id=url%3A%2Fprojects%2Ffbc%2Ffiles%2FFreeBASIC-1.09.0%2FFreeBASIC-1.09.0-linux-x86_64.tar.gz%2Fdownload&id=pagetitle%3APage+not+found%0A++++-+SourceForge.net&id=vertical%3AOpen+Source+Software";
            imageUrl = imageUrl.replace(encodeURIComponent("$PAGE_TITLE"), document.title);

            imageUrl = URL.parse(imageUrl);
            let hem = bizx.uids.getHem();
            if (hem) {
                imageUrl.searchParams.append('id', 'hem:' + hem);
            }
            imageUrl.searchParams.append('rand', current_time);

            var image = new Image();
            image.src = imageUrl.toString();
            image.style.display = "none";
            image.style.height = 0;
            image.style.width = 0;
            document.body.appendChild(image);
        });
    })
</script>




